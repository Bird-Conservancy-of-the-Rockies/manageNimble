\name{gatherNimble2}
\alias{gatherNimble2}
\title{
  Gather the second NIMBLE monitor set
}
\description{
  Internal function called by \code{\link{runNimble}} to gather the second monitor set (\code{parameters2}/\code{monitors2}) from the block dumps written by \code{\link{runNimbleBlock}}. Companion to \code{\link{gatherNimble}}, which gathers the primary set. Not exported; called via \code{manageNimble:::gatherNimble2}.

  Handled more simply than \code{gatherNimble}: blocks falling entirely within burn-in are dropped, any residual burn-in within the first retained block is trimmed per chain (at \code{nt2}'s granularity), and \code{max.rows} (if supplied) systematically subsamples the concatenated result - no further thinning is applied, since \code{thin2} already set the rate at sampling time. Chains are stacked into a single matrix; chain identity is not preserved, because this monitor set is intended for post hoc calculations over the posterior rather than for convergence diagnostics.

  Returns \code{NULL} with a warning if no block dump contains a second set, which is the expected result when \code{\link{runNimble}} was called without \code{parameters2}.
}
\usage{
  gatherNimble2(read.path, burnin, ni.block, nt2 = 1, save.path = NULL,
                max.rows = NULL)
}
\arguments{
  \item{read.path}{Path to directory containing sample blocks generated by \code{\link{runNimble}}.}
  \item{burnin}{Number of samples (if >= 1) or proportion of the chain (if < 1) to discard at the beginning of each chain.}
  \item{ni.block}{Number of samples in each sampling block.}
  \item{nt2}{Thinning rate the second monitor set was sampled at (i.e., \code{nt2} as passed to \code{\link{runNimble}}). Needed to correctly convert residual burn-in from iterations to draws.}
  \item{save.path}{If provided, the gathered matrix is also written here via \code{saveRDS}.}
  \item{max.rows}{Optional cap on the number of rows in the returned matrix; if the concatenated result has more rows than this, it is systematically subsampled down to (approximately) \code{max.rows}.}
}
\value{
  A \code{[ndraw, nparam]} matrix with chains stacked, or \code{NULL} (with a warning) if no second monitor set is found or no blocks remain after burn-in.
}
\author{
  Quresh S. Latif, Bird Conservancy of the Rockies
}
\keyword{internal}
\keyword{nimble}
\keyword{runNimble}
