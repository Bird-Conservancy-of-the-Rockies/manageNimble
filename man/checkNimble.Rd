\name{checkNimble}
\alias{checkNimble}
\title{
  Check NIMBLE model for convergence
}
\description{
  Base function called by \code{\link{runNimble}} to check NIMBLE model progress toward convergence.
}
\usage{
  checkNimble(mcmcOutput, Rht.required = 1.1, neff.required = 100,
                        par.ignore = c(), par.dontign = c(),
                        par.fuzzy.track = c(), fuzzy.threshold = 0.05,
                        spit.summary = FALSE, mod.nam = "mod", directive.file = "")
}
\arguments{
  \item{mcmcOutput}{Object containing MCMC samples compiled as an mcmcOutput object most likely but not necessarily generated by 'gatherNimble'.}
  \item{Rht.required}{Maximum Rhat allowed for returning a check result of TRUE.}
  \item{neff.required}{Minimum n.effective required to return a check result of TRUE.}
  \item{par.ignore}{Character vector listing parameters to ignore when checking Rhat and n.effective. Any parameter containing any of the strings listed here will be ignored - this can match more than intended (e.g. \code{par.ignore = "p"} also matches \code{beta.p} and \code{mu.p}); use \code{par.dontign} to rescue any of those.}
  \item{par.dontign}{Character vector listing parameters that should not be ignored when checking Rhat and n.effective, even though their names contain one of the strings in \code{par.ignore}. Unnecessary if \code{par.ignore} is not specified.}
  \item{par.fuzzy.track}{Character vector listing parameters to designate for fuzzy evaluation of convergence. These are excluded from the strict Rhat/n.effective test that governs every other parameter, and instead checked against \code{fuzzy.threshold}: the function returns FALSE if more than that proportion of them have Rhat > \code{Rht.required} or n.effective < \code{neff.required}. An NA Rhat or n.effective among these parameters is always fatal (a \code{stop()}), the same as for any other parameter - it is not tolerated by \code{fuzzy.threshold}. Default is an empty vector, whereby no fuzzy evaluation of convergence will occur.}
  \item{fuzzy.threshold}{Threshold for fuzzy evaluation of convergence (only relevant if length(par.fuzzy.track) > 0).}
  \item{spit.summary}{Whether to also return the full parameter summary table (\code{s}, below). \code{result} and \code{prp.fuzzy.not.converged} are always returned.}
  \item{mod.nam}{Character string used to label diagnostic CSVs written on a fatal (NA or Inf/-Inf Rhat or n.effective) stop: \code{Bad_pars_<mod.nam>.csv} for strictly-checked parameters, \code{Bad_pars_fuzzy_<mod.nam>.csv} for fuzzy-tracked ones.}
  \item{directive.file}{If provided (directive.file != ""), 'STOP' order is written to specified file path if Rhat could not be calculated at all, to (safely) end MCMC sampling.}
}
\value{
  \item{result}{Logical indicating whether the model represented by mcmcOutput meets specified Rhat and n.effective criteria.}
  \item{prp.fuzzy.not.converged}{Proportion of \code{par.fuzzy.track} parameters failing Rhat or n.effective. \code{NA} if \code{par.fuzzy.track} is empty.}
  \item{s}{If spit.summary = TRUE, summary table of parameter estimates as provided by summary.mcmcOutput.}
}
\author{
  Bryan L. Nuse and Quresh S. Latif, Bird Conservancy of the Rockies.

  Substantially revised with Claude (Anthropic) assistance during a full code review; see
  \code{NEWS.md} for what changed, including the fuzzy-tracking and NA-handling behaviour.
}

\keyword{nimble}
\keyword{mcmcOutput}
\keyword{runNimble}
