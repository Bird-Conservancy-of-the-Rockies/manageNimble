\name{gatherNimble}
\alias{gatherNimble}
\title{
  Gather NIMBLE samples
}
\description{
  Internal function called by \code{\link{runNimble}} to gather and organize NIMBLE samples (the primary monitor set) into an mcmcOutput object. Not exported; called via \code{manageNimble:::gatherNimble}.

  Sample blocks are loaded one at a time and immediately reduced to the rows that will actually be retained (after burn-in and any \code{max.samples.saved} subsampling), rather than loading every retained block before thinning - peak memory therefore scales with \code{max.samples.saved}, not with the total amount of data sampled so far.
}
\usage{
  gatherNimble(read.path, burnin, ni.block, base.thin, max.samples.saved,
               directive.file = "")
}
\arguments{
  \item{read.path}{Path to directory containing sample blocks generated by \code{\link{runNimble}}.}
  \item{burnin}{Number of samples (if >= 1) or proportion of the chain (if < 1) to discard at the beginning of each chain when gathering MCMC samples from saved blocks.}
  \item{ni.block}{Number of samples in each sampling block.}
  \item{base.thin}{Base thinning rate implemented for model run (i.e., n.thin for initial call to `runNimble`). Needed to correctly track burnin.}
  \item{max.samples.saved}{Integer that sets max samples to save \strong{per chain} in final model object, or \code{NULL} for no cap. Additional thinning of posterior samples (i.e., after samples are recovered from processing clusters) is implemented as necessary to limit the size of the model object to this level.}
  \item{directive.file}{If provided (directive.file != ""), 'STOP' order is written to specified file path if negative burnin encountered to (safely) end MCMC sampling.}
}
\value{
  \item{out}{MCMC samples organized as an 'mcmcOutput' object.}
  \item{nblks}{the number of sampling blocks}
  \item{additional.thin.rate}{Any additional thinning rate if max.samples.saved is specified. Set to 1 if max.samples.saved is NULL.}
}

\author{
  Bryan L. Nuse and Quresh S. Latif, Bird Conservancy of the Rockies
}
\keyword{internal}
\keyword{nimble}
\keyword{mcmcOutput}
\keyword{runNimble}
