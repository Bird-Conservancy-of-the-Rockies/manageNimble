\name{countNimbleBlocks}
\alias{countNimbleBlocks}
\title{
  Count NIMBLE sampling blocks in dump folder
}
\description{
  Internal function used by \code{\link{runNimble}} to inventory NIMBLE sampling blocks: truncates chains to equal length, drops blocks falling entirely within burn-in, and stops if a chain is missing a block (rather than renumbering, which would silently misalign chains). Not exported; called via \code{manageNimble:::countNimbleBlocks}.
}
\usage{
  countNimbleBlocks(read.path, burnin, ni.block)
}
\arguments{
  \item{read.path}{Path to directory containing sample blocks generated by \code{\link{runNimble}}.}
  \item{burnin}{Number of samples (if >= 1) or proportion of the chain (if < 1) to discard at the beginning of each chain.}
  \item{ni.block}{Number of samples in each sampling block.}
}
\value{
  \item{m}{Integer matrix whose rownames are the RData files containing sampling blocks to be gathered after applying burnin, with columns \code{chn} and \code{blk} identifying which chain and block each belongs to.}
  \item{nblks}{The number of sampling blocks each chain has produced (chains are truncated to the shortest).}
  \item{burnin}{Burn-in in samples, after resolving a proportional \code{burnin} argument against the current \code{nblks}.}
  \item{burnin.realized}{The portion of \code{burnin} accounted for by dropping whole blocks; the remainder (if any) is residual burn-in for the caller to trim within the first retained block.}
}

\author{
  Bryan L. Nuse and Quresh S. Latif, Bird Conservancy of the Rockies
}
\keyword{internal}
\keyword{nimble}
\keyword{runNimble}
